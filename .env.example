# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Variables are described in DESIGN.md > Configuration.

# Supabase: run `supabase status` after `supabase start` to get the local values.
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key-from-supabase-status
# Server only. Used solely by lib/server/service-client.ts.
SUPABASE_SECRET_KEY=replace-with-secret-key-from-supabase-status

# App
APP_URL=http://localhost:3000

# Mock HRIS (the mock service reads the same key)
HRIS_API_URL=http://localhost:4000
# Generate with: openssl rand -hex 32
HRIS_API_KEY=replace-with-a-long-random-value

# Job endpoints. Generate with: openssl rand -hex 32. Also stored in Supabase Vault for pg_cron.
JOB_SECRET=replace-with-a-long-random-value

# Email: Mailpit locally. Check the SMTP port in `supabase status`.
SMTP_HOST=localhost
SMTP_PORT=54325
# Empty locally; set from the chosen email provider once hosted.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.test

# true only on local machines and in CI; leave unset when hosted.
TEST_CLOCK_ALLOWED=true
